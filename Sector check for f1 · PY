"""
import asyncio
import aiohttp

SECTOR_API_URL = "https://YOUR-APP.onrender.com"   # رابط خدمتك على Render (بدون / في النهاية)
SECTOR_API_KEY = ""                                  # نفس SCAN_KEY إن ضبطته على Render، وإلا اتركه فارغاً


async def fetch_sector_line(session, symbol, retries=4, building_wait=20):
    """
    يرجع (السطر، البيانات الكاملة). عند أي فشل يرجع ("", None) دون أن يوقف F1.
    المهلة 70 ثانية للطلب الأول لأن Render المجاني قد يكون نائماً.
    status 202 = قاعدة القطاعات قيد البناء بعد النوم، فنعيد المحاولة.
    """
    base = symbol.split('/')[0].upper()
    params = {"symbol": base, "format": "json", "src": "f1"}
    if SECTOR_API_KEY:
        params["key"] = SECTOR_API_KEY
    for attempt in range(retries):
        try:
            async with session.get(f"{SECTOR_API_URL}/coin", params=params,
                                   timeout=aiohttp.ClientTimeout(total=70)) as r:
                if r.status == 200:
                    data = await r.json()
                    return data.get("line", ""), data
                if r.status == 202:
                    await asyncio.sleep(building_wait)
                    continue
                return "", None          # 404/403/503 ... لا حكم
        except Exception:
            await asyncio.sleep(5)
    return "", None
